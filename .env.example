# --- Required for AI planning ---
# Anthropic API key. The planner refuses to run without it (no fake plans).
ANTHROPIC_API_KEY=

# --- Required for secret encryption ---
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FOUNDRY_MASTER_KEY=

# --- Required in production ---
# API auth token (>= 16 chars). Without it, production serves 503 on all
# protected routes — the API never silently runs open in production.
# Maps to principal "owner" in FOUNDRY_ORG_ID (default org_local).
FOUNDRY_API_TOKEN=
FOUNDRY_ORG_ID=

# Multi-principal / service-client mode (takes precedence over FOUNDRY_API_TOKEN).
# JSON array; each service client (Chief of Staff, VERIDIAN, ...) gets its own
# token and org scope. All resources (projects, plans, runs, events, creds)
# are isolated per orgId; cross-org access reads as 404. Malformed JSON fails
# closed (nobody authenticates).
# FOUNDRY_PRINCIPALS=[{"token":"<32+ chars>","id":"chief-of-staff","orgId":"org_dyln","role":"admin"}]

# --- Persistence ---
# file | sqlite. Unknown values fail closed. Default: sqlite in production
# (production-safe: WAL + transactional writes), file in dev/test.
FOUNDRY_PERSISTENCE=
# Override store paths (defaults under .foundry-data/).
FOUNDRY_SQLITE_FILE=
FOUNDRY_STORE_FILE=

# --- Optional ---
# Real GitHub repository adapter (create/verify/delete-on-rollback). Omit to
# use the clearly-labeled mock repository provider (dev/test only).
GITHUB_TOKEN=

# Real Vercel deployment adapter (create/deploy/verify/cancel). Omit to use the
# clearly-labeled mock deployment provider.
VERCEL_API_TOKEN=

# Override the planner model id.
FOUNDRY_PLANNER_MODEL=
