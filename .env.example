# --- Required for AI planning ---
# Anthropic API key. The planner refuses to run without it (no fake plans).
ANTHROPIC_API_KEY=

# --- Required for secret encryption ---
# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FOUNDRY_MASTER_KEY=

# --- Optional ---
# Redis for cross-process log streaming. Omit to use the in-process bus (single instance only).
REDIS_URL=

# Supabase persistence. Omit to run without a database (plans are not persisted).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel deploy adapter token (only needed to execute deploy plans).
VERCEL_API_TOKEN=
